# ============================================================================
# CONFIGURACIÓN DE DESARROLLO - CLINIC RECORDS
# ============================================================================

# ============================================================================
# DJANGO CORE
# ============================================================================
DEBUG=True
SECRET_KEY=your-secret-key-here-change-this
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# DATABASE (PostgreSQL REQUERIDO)
# ============================================================================
DATABASE_NAME=clinic_records_db
DATABASE_USER=clinic_admin
DATABASE_PASSWORD=your_db_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Crear DB: 
# psql -U postgres
# CREATE DATABASE clinic_records_db;
# CREATE USER clinic_admin WITH PASSWORD 'your_password';
# GRANT ALL PRIVILEGES ON DATABASE clinic_records_db TO clinic_admin;

# ============================================================================
# REDIS (REQUERIDO para Celery, Cache y Notificaciones)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Instalar Redis:
# Windows: https://github.com/microsoftarchive/redis/releases
# Mac: brew install redis
# Linux: sudo apt install redis-server

# ============================================================================
# CORS (Frontend URLs permitidas)
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# JWT (Autenticación)
# ============================================================================
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ============================================================================
# AWS S3 (Opcional en desarrollo, REQUERIDO en producción)
# ============================================================================
USE_S3=False
USE_S3_BACKUP=False
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=us-east-1
AWS_TEXTRACT_REGION=us-east-1

# OCR Automático (requiere AWS Textract)
ENABLE_OCR=False

# Para obtener credenciales AWS:
# 1. Ir a AWS IAM → Users → Create User
# 2. Asignar políticas: AmazonS3FullAccess, AmazonTextractFullAccess
# 3. Crear Access Key → Copiar ID y Secret

# ============================================================================
# FRONTEND URL
# ============================================================================
FRONTEND_URL=http://localhost:5173
BASE_DOMAIN=.com

# ============================================================================
# SENDGRID (Email - Opcional en desarrollo)
# ============================================================================
SENDGRID_ENABLED=False
SENDGRID_API_KEY=your_sendgrid_api_key_here
DEFAULT_FROM_EMAIL=noreply@example.com

# Para obtener API Key:
# 1. Crear cuenta en https://sendgrid.com (gratis hasta 100 emails/día)
# 2. Settings → API Keys → Create API Key
# 3. Copiar key (solo se muestra una vez)

# ============================================================================
# STRIPE (Pagos - Opcional en desarrollo)
# ============================================================================
STRIPE_ENABLED=False
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Para obtener keys de Stripe:
# 1. Crear cuenta en https://dashboard.stripe.com/register
# 2. Developers → API Keys → Copiar "Secret key" y "Publishable key"
# 3. Para webhook: Developers → Webhooks → Add endpoint
#    URL: http://localhost:8000/api/payments/stripe-webhook/
#    Events: checkout.session.completed, customer.subscription.created, etc.

# ============================================================================
# FIREBASE (Notificaciones Push - Opcional en desarrollo)
# ============================================================================
FIREBASE_SERVER_KEY=your_firebase_server_key_here

# Service Account JSON (copiar todo el contenido en una sola línea)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"...","universe_domain":"googleapis.com"}'

# Para obtener credenciales Firebase:
# 1. Ir a Firebase Console: https://console.firebase.google.com
# 2. Project Settings → Service Accounts → Generate New Private Key
# 3. Copiar todo el JSON en una sola línea (sin saltos de línea)
# 4. Para Server Key: Cloud Messaging → Server Key (Legacy)